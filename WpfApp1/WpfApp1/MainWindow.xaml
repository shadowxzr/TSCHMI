<Window x:Class="TSCHMI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Менеджер задач"
        WindowState="Maximized"
        MinWidth="600" MinHeight="400">

    <Window.Resources>
        <!-- КИСТИ -->
        <SolidColorBrush x:Key="HeaderBrush" Color="#2C3E50"/>
        <SolidColorBrush x:Key="StatusBrush" Color="#ECF0F1"/>
        <SolidColorBrush x:Key="SideBrush"   Color="#F4F6F7"/>
        <SolidColorBrush x:Key="CardBrush"   Color="#FBFCFC"/>
        <SolidColorBrush x:Key="LineBrush"   Color="#DDD"/>

        <!-- Градиентная кисть для шапки -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#2C3E50" Offset="0"/>
            <GradientStop Color="#34495E" Offset="1"/>
        </LinearGradientBrush>

        <!-- СТРОКИ -->
        <sys:String x:Key="AppTitle">Менеджер задач</sys:String>
        <sys:String x:Key="ProjectsLabel">Проекты</sys:String>
        <sys:String x:Key="CardLabel">Карточка задачи</sys:String>

        <!-- СТИЛЬ: все кнопки -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin"  Value="0,0,6,0"/>
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2980B9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- СТИЛЬ: элементы списка задач -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,4"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D6EAF8"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- СТИЛЬ: поля ввода -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin"  Value="0,2,0,0"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- ВЕРХ: шапка с градиентом -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource HeaderGradient}" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="{StaticResource AppTitle}"
                           Foreground="White"
                           FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <WrapPanel HorizontalAlignment="Right">
                    <Button Content="Новая"
                            Command="{Binding AddTaskCommand}"/>
                    <Button Content="Настройки"
                            Command="{Binding OpenSettingsCommand}"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- НИЗ: статус -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource StatusBrush}" Padding="6">
            <TextBlock Text="{Binding Status}"/>
        </Border>

        <!-- ЛЕВО: проекты -->
        <Border DockPanel.Dock="Left"
                Background="{StaticResource SideBrush}"
                Padding="8" MinWidth="160">
            <StackPanel>
                <TextBlock Text="{StaticResource ProjectsLabel}"
                           FontWeight="Bold" Margin="0,0,0,8"/>
                <ListBox>
                    <ListBoxItem Content="Все задачи"/>
                    <ListBoxItem Content="Работа"/>
                    <ListBoxItem Content="Личное"/>
                    <ListBoxItem Content="Учёба"/>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- ПРАВО: карточка задачи -->
        <Border DockPanel.Dock="Right"
                Background="{StaticResource CardBrush}"
                Padding="8" MinWidth="220">
            <StackPanel>
                <TextBlock Text="{StaticResource CardLabel}"
                           FontWeight="Bold" Margin="0,0,0,8"/>

                <TextBlock Text="Название:"/>
                <TextBox/>

                <!-- Разделитель: фигура Rectangle -->
                <Rectangle Height="1"
                           Fill="{StaticResource LineBrush}"
                           Margin="0,10"/>

                <TextBlock Text="Приоритет:"/>

                <!-- Индикаторы приоритета: фигуры Ellipse -->
                <UniformGrid Rows="1" Columns="3">
                    <Button Margin="2">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="12" Height="12" Fill="#2ECC71"
                     Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Низкий" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="2">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="12" Height="12" Fill="#F1C40F"
                     Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Средний" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="2">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="12" Height="12" Fill="#E74C3C"
                     Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Высокий" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <TextBlock Text="Описание:" Margin="0,10,0,0"/>
                <TextBox AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         MinHeight="80"/>
            </StackPanel>
        </Border>

        <!-- ЦЕНТР: список задач + панель действий -->
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ListBox BorderThickness="0">
                        <ListBoxItem Content="Сверстать макет"/>
                        <ListBoxItem Content="Выбрать тему"/>
                        <ListBoxItem Content="Согласовать с руководителем"/>
                        <ListBoxItem Content="Подготовить отчёт"/>
                    </ListBox>
                </ScrollViewer>
            </Border>

            <!-- Панель действий -->
            <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                <Button Content="Добавить"
                        Command="{Binding AddTaskCommand}"/>
                <Button Content="Удалить"
                        Command="{Binding DeleteTaskCommand}"/>
                <Button Content="Выполнено"
                        Command="{Binding MarkDoneCommand}"/>
            </WrapPanel>
        </Grid>
    </DockPanel>
</Window>